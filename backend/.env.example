# MongoDB Atlas connection string (must include the DB name)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/rag_assistant?retryWrites=true&w=majority
MONGO_URI=

# Secret used to sign JWTs — any long random string
JWT_SECRET=

# Google AI Studio API key (Gemini) — used for embeddings, chat, and tool calling
GEMINI_API_KEY=

# Discord webhook URL used by the send_discord_summary tool
DISCORD_WEBHOOK_URL=

# Port the backend listens on
PORT=5000

# Comma-separated origins allowed to call this API (your deployed frontend URL, plus localhost for dev)
CORS_ORIGIN=http://localhost:5173
